{
  "id": "invalid-email-rejected",
  "title": "Checkout with an invalid email is rejected",
  "steps": [
    { "do": "goto", "path": "/" },
    { "do": "click", "testId": "add-to-cart-3" },
    { "do": "waitFor", "testId": "cart-count", "text": "1" },
    { "do": "goto", "path": "/checkout" },
    { "do": "fill", "testId": "checkout-email", "value": "not-an-email" },
    { "do": "click", "testId": "place-order" },
    { "do": "waitFor", "testId": "checkout-error" }
  ],
  "expect": [
    { "path": "ui.url", "equals": "/checkout" },
    { "path": "network.last[\"POST /api/orders\"].status", "equals": 400 },
    { "path": "db.orders.added.length", "equals": 0 },
    { "path": "db.order_items.added.length", "equals": 0 }
  ]
}
