{
  "id": "coupon-application-reduces-total",
  "title": "Valid coupon reduces the order total",
  "description": "Applying a percentage coupon lowers the total shown and stored.",
  "candidateOnly": true,
  "steps": [
    { "do": "goto", "path": "/" },
    { "do": "click", "testId": "add-to-cart-2" },
    { "do": "goto", "path": "/checkout" },
    { "do": "fill", "testId": "coupon-code", "value": "SAVE10" },
    { "do": "click", "testId": "apply-coupon" },
    { "do": "waitFor", "testId": "coupon-applied" },
    { "do": "capture", "testId": "checkout-total", "as": "displayedTotal", "parse": "money" },
    { "do": "fill", "testId": "checkout-email", "value": "coupon@example.com" },
    { "do": "click", "testId": "place-order" },
    { "do": "waitForUrl", "path": "/order/*" },
    { "do": "capture", "testId": "order-total", "as": "orderTotal", "parse": "money" }
  ],
  "expect": [
    { "path": "ui.captures.displayedTotal", "equals": 7200, "description": "Checkout shows 10% off 8000 = 7200" },
    { "path": "db.orders.added[0].total_cents", "equals": 7200 },
    { "path": "ui.captures.orderTotal", "equalsPath": "db.orders.added[0].total_cents", "description": "Order page total matches database" },
    { "path": "db.orders.added[0].coupon_code", "equals": "SAVE10" }
  ]
}
