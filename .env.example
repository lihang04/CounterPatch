# Copy to .env, fill in your key and exact provider model ID, then check it:
# npm run counterpatch -- check-model --env-file .env
# generate also accepts --env-file .env. To load settings into your shell instead:
# set -a; . ./.env; set +a
# CounterPatch reads shell environment variables; it does not auto-load .env.

# OpenRouter (default provider)
OPENROUTER_API_KEY=
COUNTERPATCH_MODEL=
COUNTERPATCH_BASE_URL=https://openrouter.ai/api/v1

# Nebius: replace the base URL above with https://api.tokenfactory.nebius.com/v1,
# set COUNTERPATCH_MODEL to your Nebius model ID, and uncomment this key.
# NEBIUS_API_KEY=

# Optional key override for any compatible provider. Leave commented unless used;
# even an empty value overrides the provider-specific key.
# COUNTERPATCH_API_KEY=

# Model request limits
COUNTERPATCH_MODEL_TIMEOUT_MS=120000
COUNTERPATCH_MAX_TOKENS=8192

# Optional location for verification environments and reports (defaults to system temp).
# COUNTERPATCH_HOME=/absolute/path/to/counterpatch-data
